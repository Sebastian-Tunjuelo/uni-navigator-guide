# ============================================================
# Virtual University Concierge — Backend Environment Variables
# Copy this file to .env.local for local development.
# In production (Render), set these in the dashboard.
# ============================================================

# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Supabase
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # Only for ingest scripts — never expose to frontend

# LLM — Gemini (primary)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_CHAT_MODEL=gemini-2.5-flash

# LLM — Groq (fallback)
GROQ_API_KEY=<your-groq-api-key>
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# CORS — set to your Lovable frontend URL in production
# e.g. https://my-app.lovable.app
FRONTEND_URL=
