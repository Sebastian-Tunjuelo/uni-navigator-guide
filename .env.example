# ============================================================
# Virtual University Concierge — Frontend Environment Variables
# Copy this file to .env for local development.
# In Lovable, set these in Project Settings > Environment Variables.
# ============================================================

# Supabase
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Backend (Render)
# Local: http://localhost:3001
# Production: https://virtual-university-concierge-api.onrender.com
VITE_BACKEND_URL=http://localhost:3001
